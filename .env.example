# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# NOTE: Database credentials are retrieved from vault at runtime
# Set DATABASE_URL environment variable to point to vault secret path
# Example: DATABASE_URL will be loaded from vault path 'database/url'

DB_HOST=localhost
DB_PORT=5432
DB_NAME=openbanking_dev
DB_USER=postgres
# DB_PASSWORD is NOT stored here - retrieved from vault at runtime

# Database connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# ============================================================================
# OAUTH 2.0 CONFIGURATION
# ============================================================================
# OAuth Provider
OAUTH_ISSUER=http://localhost:8080/oauth
OAUTH_AUTHORIZATION_ENDPOINT=http://localhost:8080/oauth/authorize
OAUTH_TOKEN_ENDPOINT=http://localhost:8080/oauth/token
OAUTH_JWKS_URI=http://localhost:8080/oauth/.well-known/jwks.json

# Fintech Demo App OAuth Client
FINTECH_CLIENT_ID=fintech-demo-client
# FINTECH_CLIENT_SECRET is NOT stored here - retrieved from vault at runtime
# Vault path: oauth/fintech-client-secret
FINTECH_REDIRECT_URI=http://localhost:3000/callback

# Token expiration (in seconds)
ACCESS_TOKEN_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=86400

# ============================================================================
# API GATEWAY CONFIGURATION
# ============================================================================
GATEWAY_HOST=localhost
GATEWAY_PORT=8080
GATEWAY_BASE_URL=http://localhost:8080

# Rate limiting
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# APPLICATION SERVICES
# ============================================================================
# Fintech Demo App
FINTECH_APP_PORT=3000
FINTECH_APP_URL=http://localhost:3000

# Customer Consent App
CONSENT_APP_PORT=3001
CONSENT_APP_URL=http://localhost:3001

# Banking API
BANKING_API_PORT=3002
BANKING_API_URL=http://localhost:3002
BANKING_API_BASE_PATH=/api/v1

# ============================================================================
# VAULT CONFIGURATION
# ============================================================================
# Vault backend: 'env' (development), 'hashicorp' (production), 'aws', 'azure'
VAULT_BACKEND=env

# HashiCorp Vault configuration (when VAULT_BACKEND=hashicorp)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=PLACEHOLDER_VAULT_ROOT_TOKEN
VAULT_NAMESPACE=openbanking
VAULT_MOUNT_PATH=secret

# AWS Secrets Manager configuration (when VAULT_BACKEND=aws)
AWS_REGION=us-east-1
AWS_SECRET_PREFIX=openbanking/

# Azure Key Vault configuration (when VAULT_BACKEND=azure)
AZURE_VAULT_URL=https://your-vault.vault.azure.net
AZURE_TENANT_ID=PLACEHOLDER_AZURE_TENANT_ID
AZURE_CLIENT_ID=PLACEHOLDER_AZURE_CLIENT_ID

# Secret names (mapped to vault paths)
# These are retrieved at runtime from the configured vault backend
# Format: SECRET_NAME maps to vault path
# Example: DATABASE_URL -> database/url in vault

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# NOTE: All secrets are retrieved from vault at runtime in production
# For local development with VAULT_BACKEND=env, set these as environment variables

# Session secret for cookie signing (retrieved from vault: session/secret)
# SESSION_SECRET is loaded from vault at runtime

# JWT signing key (retrieved from vault: jwt/secret)
# JWT_SECRET is loaded from vault at runtime

# Encryption key for sensitive data (retrieved from vault: encryption/data-encryption)
# DATA_ENCRYPTION_KEY is loaded from vault at runtime

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_LEVEL=info
LOG_FORMAT=json

# Enable debug logging for specific components
DEBUG_AUTH=false
DEBUG_CONSENT=false
DEBUG_GATEWAY=false

# ============================================================================
# ENVIRONMENT
# ============================================================================
NODE_ENV=development
APP_ENV=local

# ============================================================================
# OPTIONAL: EXTERNAL SERVICES
# ============================================================================
# Redis (for session storage and caching)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD is NOT stored here - retrieved from vault at runtime
# Vault path: redis/password

# Email service (for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_USER and SMTP_PASSWORD are NOT stored here - retrieved from vault at runtime
# Vault paths: smtp/user, smtp/password
SMTP_FROM=noreply@openbanking.example.com

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
# Application monitoring
APM_ENABLED=false
APM_SERVICE_NAME=openbanking-mvp
APM_SERVER_URL=http://localhost:8200

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# ============================================================================
# FEATURE FLAGS
# ============================================================================
FEATURE_CONSENT_REVOCATION=true
FEATURE_REFRESH_TOKENS=true
FEATURE_RATE_LIMITING=true
FEATURE_AUDIT_LOGGING=true