# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=openbanking_dev
DB_USER=postgres
DB_PASSWORD=PLACEHOLDER_DB_PASSWORD

# Database connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# ============================================================================
# OAUTH 2.0 CONFIGURATION
# ============================================================================
# OAuth Provider
OAUTH_ISSUER=http://localhost:8080/oauth
OAUTH_AUTHORIZATION_ENDPOINT=http://localhost:8080/oauth/authorize
OAUTH_TOKEN_ENDPOINT=http://localhost:8080/oauth/token
OAUTH_JWKS_URI=http://localhost:8080/oauth/.well-known/jwks.json

# Fintech Demo App OAuth Client
FINTECH_CLIENT_ID=fintech-demo-client
FINTECH_CLIENT_SECRET=PLACEHOLDER_FINTECH_CLIENT_SECRET
FINTECH_REDIRECT_URI=http://localhost:3000/callback

# Token expiration (in seconds)
ACCESS_TOKEN_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=86400

# ============================================================================
# API GATEWAY CONFIGURATION
# ============================================================================
GATEWAY_HOST=localhost
GATEWAY_PORT=8080
GATEWAY_BASE_URL=http://localhost:8080

# Rate limiting
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# APPLICATION SERVICES
# ============================================================================
# Fintech Demo App
FINTECH_APP_PORT=3000
FINTECH_APP_URL=http://localhost:3000

# Customer Consent App
CONSENT_APP_PORT=3001
CONSENT_APP_URL=http://localhost:3001

# Banking API
BANKING_API_PORT=3002
BANKING_API_URL=http://localhost:3002
BANKING_API_BASE_PATH=/api/v1

# ============================================================================
# HASHICORP VAULT CONFIGURATION
# ============================================================================
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=PLACEHOLDER_VAULT_ROOT_TOKEN
VAULT_NAMESPACE=openbanking

# Vault paths for secrets
VAULT_SECRET_PATH=secret/openbanking
VAULT_DB_PATH=secret/openbanking/database
VAULT_OAUTH_PATH=secret/openbanking/oauth

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# Session secret for cookie signing
SESSION_SECRET=PLACEHOLDER_SESSION_SECRET

# JWT signing key (stored in Vault in production)
JWT_SECRET=PLACEHOLDER_JWT_SECRET

# Encryption key for sensitive data
ENCRYPTION_KEY=PLACEHOLDER_ENCRYPTION_KEY

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_LEVEL=info
LOG_FORMAT=json

# Enable debug logging for specific components
DEBUG_AUTH=false
DEBUG_CONSENT=false
DEBUG_GATEWAY=false

# ============================================================================
# ENVIRONMENT
# ============================================================================
NODE_ENV=development
APP_ENV=local

# ============================================================================
# OPTIONAL: EXTERNAL SERVICES
# ============================================================================
# Redis (for session storage and caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=PLACEHOLDER_REDIS_PASSWORD

# Email service (for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=PLACEHOLDER_SMTP_USER
SMTP_PASSWORD=PLACEHOLDER_SMTP_PASSWORD
SMTP_FROM=noreply@openbanking.example.com

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
# Application monitoring
APM_ENABLED=false
APM_SERVICE_NAME=openbanking-mvp
APM_SERVER_URL=http://localhost:8200

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# ============================================================================
# FEATURE FLAGS
# ============================================================================
FEATURE_CONSENT_REVOCATION=true
FEATURE_REFRESH_TOKENS=true
FEATURE_RATE_LIMITING=true
FEATURE_AUDIT_LOGGING=true