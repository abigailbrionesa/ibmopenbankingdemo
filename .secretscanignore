# Secrets Scanning Ignore File
# This file tells secret scanning tools to ignore certain patterns

# Test files with example credentials (not real secrets)
tests/**/*.test.js
tests/**/*.spec.js
**/__tests__/**
**/__mocks__/**

# Documentation with example credentials
docs/**/*.md
*.md

# Example and template files
*.example
*.template
.env.example

# Seed data (contains only placeholder data)
data/seed/**/*.sql

# Configuration examples
**/examples/**
**/samples/**